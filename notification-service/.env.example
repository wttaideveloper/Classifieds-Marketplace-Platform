DATABASE_URL=postgresql+psycopg2://user:password@db:5432/notifications
# one key per calling service: name:key,name:key
PRODUCER_KEYS=payments:change-me-1,chat:change-me-2,training:change-me-3
ADMIN_KEY=change-me-admin

WORKER_ENABLED=true
MAX_ATTEMPTS=5

# Push (leave empty to only log)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# Email (leave SMTP_HOST empty to only log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
