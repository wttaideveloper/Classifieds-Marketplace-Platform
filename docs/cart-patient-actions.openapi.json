    "/api/v1/refunds": {
      "post": {
        "tags": [
          "Refunds"
        ],
        "summary": "Ask for a refund, or refund a payment",
        "description": "FR-REF-01, FR-REF-02. A customer's request waits for the business (or platform) to approve it. When the business or platform refunds, it is approved and sent to the gateway at once. Leave `amount` out for a full refund of what is left. A credit note, the tax reversal and the order update follow when it completes.",
        "operationId": "create_refund_api_v1_refunds_post",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
