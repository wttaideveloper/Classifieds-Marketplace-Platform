                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Super Admin only",
              "title": "Tenant Id"
            },
            "description": "Super Admin only"
          },
          {
            "name": "overdue",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
