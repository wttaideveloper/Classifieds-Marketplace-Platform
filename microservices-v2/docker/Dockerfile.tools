# One-shot image that creates every v2 service's tables in its own NEW database (docker compose --profile init).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 && rm -rf /var/lib/apt/lists/*
COPY microservices-v2/requirements-base.txt /srv/requirements-base.txt
RUN pip install --upgrade pip && pip install -r /srv/requirements-base.txt
COPY microservices-v2/kit /srv/kit
RUN pip install /srv/kit
COPY microservices-v2/services /srv/services
COPY microservices-v2/docker/create_all_schemas.py /srv/tools/create_all_schemas.py
CMD ["python", "/srv/tools/create_all_schemas.py"]
