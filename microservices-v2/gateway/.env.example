# API gateway - example configuration (no secrets needed).
LOG_LEVEL=INFO
LOG_FORMAT=text
# Same values as the services: decides where Socket.IO lives (/socket.io, or /api/socket.io in production).
ENVIRONMENT=development
SOCKETIO_PATH=/socket.io
SOCKETIO_STANDALONE=false
# Where each service listens (docker compose service names by default).
IDENTITY_SERVICE_URL=http://identity:8000
CATALOG_SERVICE_URL=http://catalog:8000
BOOKING_SERVICE_URL=http://booking:8000
EVENTS_SERVICE_URL=http://events:8000
LEARNING_SERVICE_URL=http://learning:8000
COMMERCE_SERVICE_URL=http://commerce:8000
COMMUNICATION_SERVICE_URL=http://communication:8000
NOTIFICATIONS_SERVICE_URL=http://notifications:8000
CONTENT_SERVICE_URL=http://content:8000
MEETINGS_SERVICE_URL=http://meetings:8000
MODERATION_SERVICE_URL=http://moderation:8000
# Timeouts (seconds) and safe retries (only refused connections of GET/HEAD/OPTIONS/DELETE).
GATEWAY_CONNECT_TIMEOUT=5
GATEWAY_READ_TIMEOUT=300
GATEWAY_WRITE_TIMEOUT=300
GATEWAY_POOL_TIMEOUT=10
GATEWAY_RETRY_ATTEMPTS=2
GATEWAY_RETRY_BACKOFF=0.2
# Add X-Request-ID to responses (the monolith did not send this header).
GATEWAY_ECHO_REQUEST_ID=true
