{
 "services": {
  "identity": {
   "port": 8101,
   "jobs": [],
   "socketio": false,
   "owns_docs": true,
   "description": "Authentication and identity (Invigorate/Keycloak token integration, dev tokens, chat tokens), saved addresses, system health/inventory, and the public API documentation."
  },
  "catalog": {
   "port": 8102,
   "jobs": [],
   "socketio": false,
   "owns_docs": false,
   "description": "Enterprises and their locations, products, services, dynamic attributes, catalog search and onboarding form templates."
  },
  "booking": {
   "port": 8103,
   "jobs": [
    "service_booking_jobs"
   ],
   "socketio": false,
   "owns_docs": false,
   "description": "Service bookings: availability slots, booking settings, bookings, holds and reminders."
  },
  "events": {
   "port": 8104,
   "jobs": [
    "event_discussion_jobs"
   ],
   "socketio": false,
   "owns_docs": false,
   "description": "Events, event categories and types, event media, discussions, event form configuration and the common (event + training) form contract."
  },
  "learning": {
   "port": 8105,
   "jobs": [
    "training_reminders"
   ],
   "socketio": false,
   "owns_docs": false,
   "description": "Trainings (also served as /courses), training categories, programs, eBooks, learning media, form configuration for trainings and programs, and the learner's own trainings (/me)."
  },
  "commerce": {
   "port": 8106,
   "jobs": [
    "payment_jobs"
   ],
   "socketio": false,
   "owns_docs": false,
   "description": "Cart and orders, payments, payment methods, currencies, tax, invoices, refunds, settlements, payment reports and finance."
  },
  "communication": {
   "port": 8107,
   "jobs": [
    "group_data_export"
   ],
   "socketio": true,
   "owns_docs": false,
   "description": "Chat: conversations, groups, messages, attachments, typing, presence, devices, chat notifications, provider assignment, subscriptions, chat admin and the Socket.IO real-time server."
  },
  "notifications": {
   "port": 8108,
   "jobs": [],
   "socketio": false,
   "owns_docs": false,
   "description": "Platform notifications, per-user notification settings/inbox and notification templates."
  },
  "content": {
   "port": 8109,
   "jobs": [],
   "socketio": false,
   "owns_docs": false,
   "description": "CMS blogs and generic file uploads."
  },
  "meetings": {
   "port": 8110,
   "jobs": [
    "meeting_jobs"
   ],
   "socketio": false,
   "owns_docs": false,
   "description": "Virtual meeting provider integration (Zoom, Google Meet, Microsoft Teams)."
  },
  "moderation": {
   "port": 8111,
   "jobs": [],
   "socketio": false,
   "owns_docs": false,
   "description": "Super-admin approval queues (events, trainings, courses, programs, event categories/audits) and review moderation."
  }
 },
